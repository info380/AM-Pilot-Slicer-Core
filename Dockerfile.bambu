# syntax=docker/dockerfile:1.7
# Reuse the released Prusa binary for Prusa slicing and Bambu source geometry.
ARG PRUSA_RUNTIME_IMAGE=ghcr.io/info380/am-pilot-slicer-core@sha256:0538a4153ba17dca093b76e0ae23253308c6f8eeaf5832fd78ef668de7115285
ARG UBUNTU_RUNTIME_IMAGE=ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60
ARG NODE_BUILD_IMAGE=node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
FROM ${NODE_BUILD_IMAGE} AS dependencies
WORKDIR /worker
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev \
    && node -e 'require("node:fs").writeFileSync("/worker/bootstrap-ca.crt", require("node:tls").rootCertificates.join("\n") + "\n")'
FROM ${PRUSA_RUNTIME_IMAGE} AS geometry
FROM ${UBUNTU_RUNTIME_IMAGE} AS bambu-download
COPY --from=dependencies /worker/bootstrap-ca.crt /etc/ssl/certs/ca-certificates.crt
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble main universe' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble-updates main universe' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble-security main universe' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --location --proto '=https' --tlsv1.2 \
      'https://github.com/bambulab/BambuStudio/releases/download/v02.08.02.61/BambuStudio_ubuntu22.04-v02.08.02.61-20260820225108.AppImage' \
      --output /tmp/bambu.AppImage \
    && echo '69426a59682574591590f51c913d3889baa19252d1c8e9fcae2497eb0ed6bf92  /tmp/bambu.AppImage' | sha256sum --check --strict \
    && chmod +x /tmp/bambu.AppImage && cd /opt && /tmp/bambu.AppImage --appimage-extract >/dev/null \
    && rm -rf /opt/squashfs-root/resources/web
FROM ${UBUNTU_RUNTIME_IMAGE} AS runtime
COPY --from=dependencies /worker/bootstrap-ca.crt /etc/ssl/certs/ca-certificates.crt
LABEL org.opencontainers.image.title="AM Pilot Shared Slicer Worker" \
      org.opencontainers.image.source="https://github.com/info380/AM-Pilot-Slicer-Core" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.bambustudio.version="02.08.02.61" \
      org.opencontainers.image.bambustudio.revision="926a7192574bcb9b3a732e1ec59a46d79cb45466"
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble main universe' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble-updates main universe' \
      'deb [check-valid-until=no] http://snapshot.ubuntu.com/ubuntu/20261002T000000Z noble-security main universe' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
      ca-certificates libwebkit2gtk-4.1-0 libglu1-mesa libosmesa6 libsecret-1-0 \
      libgstreamer-plugins-base1.0-0 libpng16-16t64 libgmp10 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin worker
COPY --from=geometry /usr/local/bin/node /usr/local/bin/node
COPY --from=geometry /opt/prusa /opt/prusa
COPY --from=bambu-download /opt/squashfs-root /opt/bambu
WORKDIR /worker
COPY --from=dependencies /worker/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src
COPY schemas ./schemas
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md SOURCE_OFFER.md ./
ENV NODE_ENV=production LD_LIBRARY_PATH=/opt/prusa/lib \
    PRUSA_SLICER_CMD=/opt/prusa/bin/prusa-slicer \
    BAMBU_STUDIO_CMD=/opt/bambu/AppRun \
    SLICER_ENGINE_KEYS=fdm.am_pilot_prusa_core,fdm.am_pilot_bambu_core \
    SLICER_WORK_ROOT=/tmp/am-pilot-slicer-worker
RUN mkdir -p /tmp/am-pilot-slicer-worker && chown worker:worker /tmp/am-pilot-slicer-worker
USER worker
RUN node --input-type=module --eval \
    "const c={prusaSlicerCommand:process.env.PRUSA_SLICER_CMD,bambuStudioCommand:process.env.BAMBU_STUDIO_CMD,workRoot:process.env.SLICER_WORK_ROOT,requestTimeoutMs:30000,maximumLogBytes:262144}; await (await import('./src/engine.js')).verifyPrusaSlicer(c); await (await import('./src/bambu-engine.js')).verifyBambuStudio(c);"
STOPSIGNAL SIGTERM
CMD ["node", "src/index.js"]
