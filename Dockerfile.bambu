# syntax=docker/dockerfile:1.7
# Native runtime from signed/scanned bambu-v0.3.3, with permanent corresponding source:
# https://github.com/info380/AM-Pilot-Slicer-Core/releases/tag/bambu-v0.3.3
ARG VERIFIED_RUNTIME_IMAGE=ghcr.io/info380/am-pilot-slicer-core-bambu@sha256:3545ba6ac6accb118628c3e83e82d25400e525d80dda9e1de35fe8e353840385
ARG VERIFIED_PRUSA_NATIVE_IMAGE=ghcr.io/info380/am-pilot-slicer-core@sha256:dc27911eba78c783330e5d2216c0e5a53ebc8519e88217c5796d148e11a6ea11
ARG NODE_BUILD_IMAGE=node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
FROM ${NODE_BUILD_IMAGE} AS dependencies
WORKDIR /worker
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev
FROM ${VERIFIED_PRUSA_NATIVE_IMAGE} AS prusa-native
FROM ${VERIFIED_RUNTIME_IMAGE} AS runtime
ARG VERIFIED_PRUSA_NATIVE_IMAGE
USER root
WORKDIR /worker
# Replace the worker and Prusa component; retain the verified Bambu runtime.
RUN rm -rf ./src ./schemas ./node_modules /opt/prusa
# Reuse only the signed, stock-output-compared native component. Its standalone
# Debian runtime, package manager and worker are not included in this image.
COPY --from=prusa-native /opt/prusa /opt/prusa
COPY native/prusa/runtime-plan.json /opt/prusa/native-runtime-plan.json
RUN node --input-type=module --eval \
    "import fs from 'node:fs'; import {createHash} from 'node:crypto'; import assert from 'node:assert/strict'; const p=JSON.parse(fs.readFileSync('/opt/prusa/native-runtime-plan.json')); assert.equal(p.image,process.env.VERIFIED_PRUSA_NATIVE_IMAGE); assert.equal(createHash('sha256').update(fs.readFileSync('/opt/prusa/bin/prusa-slicer')).digest('hex'),p.binarySha256);" \
    && LD_LIBRARY_PATH=/opt/prusa/lib ldd /opt/prusa/bin/prusa-slicer > /tmp/prusa-native-ldd.txt \
    && ! grep -F 'not found' /tmp/prusa-native-ldd.txt \
    && rm /tmp/prusa-native-ldd.txt
LABEL org.opencontainers.image.title="AM Pilot Shared Slicer Worker" \
      org.opencontainers.image.source="https://github.com/info380/AM-Pilot-Slicer-Core" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.bambustudio.version="02.08.02.61" \
      org.opencontainers.image.bambustudio.revision="926a7192574bcb9b3a732e1ec59a46d79cb45466"
# Assert the security-fixed packages inherited from the signed runtime.
RUN test "$(dpkg-query -W -f='${Version}' libbrotli1)" = '1.1.0-2ubuntu0.1' \
    && test "$(dpkg-query -W -f='${Version}' zlib1g)" = '1:1.3.dfsg-3.1ubuntu2.3' \
    && test "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" = '10.42-4ubuntu2.2' \
    && test "$(dpkg-query -W -f='${Version}' libsoup-3.0-0)" = '3.4.4-5ubuntu0.10' \
    && test "$(dpkg-query -W -f='${Version}' libsoup-3.0-common)" = '3.4.4-5ubuntu0.10'
# Runtime updates use a new immutable image. No package manager is required by
# native slicing, normalization or the worker protocol. Keep dependency checks
# enabled rather than forcing removal of a library still needed by the runtime.
RUN dpkg --purge apt libapt-pkg6.0t64
WORKDIR /worker
COPY --from=dependencies /worker/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src
COPY schemas ./schemas
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md SOURCE_OFFER.md ./
# Prepared only from the checksum-locked successful native build. The build
# context contains no customer geometry or settings and cannot replace itself.
# Remove inherited bundled media copies; the explicit reduced closure below is
# the only FFmpeg runtime shipped by the application bundle.
RUN find /opt/bambu/bin -maxdepth 1 \( \
      -name 'libavcodec.so*' -o -name 'libavutil.so*' -o -name 'libswscale.so*' \
      -o -name 'libswresample.so*' -o -name 'libavformat.so*' -o -name 'libavfilter.so*' -o -name 'libavdevice.so*' \
    \) -delete
COPY native/bambu/runtime/ /opt/bambu/
LABEL org.opencontainers.image.bambustudio.patch="seam-visibility-reuse-v1+zero-paint-penetration-v1" \
      org.opencontainers.image.bambustudio.native-source="c26d824c8326db943fc6651a726d633f075b6240"
RUN cd /opt/bambu \
    && sha256sum --check --strict native-runtime.SHA256SUMS \
    && LD_LIBRARY_PATH=/opt/bambu/native-lib:/opt/bambu/bin ldd bin/bambu-studio > /tmp/bambu-native-ldd.txt \
    && ! grep -F 'not found' /tmp/bambu-native-ldd.txt \
    && rm /tmp/bambu-native-ldd.txt
ENV NODE_ENV=production LD_LIBRARY_PATH=/opt/prusa/lib \
    PRUSA_SLICER_CMD=/opt/prusa/bin/prusa-slicer \
    BAMBU_STUDIO_CMD=/opt/bambu/AppRun \
    SLICER_ENGINE_KEYS=fdm.am_pilot_prusa_core,fdm.am_pilot_bambu_core \
    SLICER_WORK_ROOT=/tmp/am-pilot-slicer-worker
RUN mkdir -p /tmp/am-pilot-slicer-worker && chown worker:worker /tmp/am-pilot-slicer-worker
USER worker
RUN test "$(node -p process.versions.node)" = "22.23.4" \
    && node --input-type=module --eval \
    "const c={prusaSlicerCommand:process.env.PRUSA_SLICER_CMD,bambuStudioCommand:process.env.BAMBU_STUDIO_CMD,workRoot:process.env.SLICER_WORK_ROOT,requestTimeoutMs:30000,maximumLogBytes:262144}; await (await import('./src/engine.js')).verifyPrusaSlicer(c); await (await import('./src/bambu-engine.js')).verifyBambuStudio(c);"
STOPSIGNAL SIGTERM
CMD ["node", "src/index.js"]
